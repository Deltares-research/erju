# Ignore data folder (if data is stored outside the repo, remove this)
data/

# Ignore Python virtual environments
venv/
.venv/
env/

# IDE / editor folders
# JetBrains (PyCharm, etc.)
.idea/
# VS Code user settings
.vscode/
# Vim swap files
*.swp

# Compiled Python files
__pycache__/
*.pyc
*.pyo

# Jupyter notebook checkpoints
notebooks/.ipynb_checkpoints/

# Log files and debugging artifacts
*.log
logs/

# macOS / Windows system files
.DS_Store
Thumbs.db

# Generated output plots produced by root-level scripts at runtime
# (oracle_attenuation_check.py, report_*.py, predict_pgv.py, etc.)
/*.png
/*.svg
